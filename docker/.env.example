# ─────────────────────────────────────────────────────────
# ZeroClaw Docker Environment
# ─────────────────────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env

# Provider API key (set the one you use, leave others empty)
VENICE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Gateway auth token (clients must send this to access the API)
ZCGW_AUTH_TOKEN=test-token-123

# Shared secret for gateway <-> instance gRPC communication
ZCGW_GRPC_SECRET=grpc-secret-456

# Google OAuth (redirect-based flow)
# Paste the full contents of your Google Cloud OAuth client credentials JSON
ZEROCLAW_GOOGLE_CREDENTIALS_JSON=
# Public hostname for Google OAuth redirect URI (e.g. myapp.example.com)
ZEROCLAW_GOOGLE_REDIRECT_HOST=
